<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Tarea programada diaria: alerta de stock bajo -->
        <record id="ir_cron_alerta_stock_bajo" model="ir.cron">
            <field name="name">GameStore: alerta de stock bajo</field>
            <field name="model_id" ref="model_gamestore_videojuego"/>
            <field name="state">code</field>
            <field name="code">model._cron_alerta_stock_bajo()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
