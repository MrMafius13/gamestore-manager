<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================ -->
    <!-- HERENCIA del formulario de contacto: smart button + pestaña       -->
    <!-- ================================================================ -->
    <record id="view_res_partner_form_gamestore" model="ir.ui.view">
        <field name="name">res.partner.form.gamestore</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_ver_pedidos_gamestore" type="object" class="oe_stat_button"
                        icon="fa-gamepad" invisible="not es_cliente_gamestore"
                        groups="gamestore_manager.group_gamestore_dependiente">
                    <field name="gamestore_pedido_count" widget="statinfo" string="Pedidos"/>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="GameStore" name="gamestore" groups="gamestore_manager.group_gamestore_dependiente">
                    <group>
                        <group string="Cliente">
                            <field name="es_cliente_gamestore"/>
                            <field name="gamestore_plataforma_favorita_id" invisible="not es_cliente_gamestore"/>
                        </group>
                        <group string="Estadísticas" invisible="not es_cliente_gamestore">
                            <field name="gamestore_currency_id" invisible="1"/>
                            <field name="gamestore_total_gastado" widget="monetary"/>
                            <field name="gamestore_ultima_compra"/>
                        </group>
                    </group>
                    <separator string="Historial de compras" invisible="not es_cliente_gamestore"/>
                    <field name="gamestore_pedido_ids" readonly="1" invisible="not es_cliente_gamestore">
                        <list decoration-muted="estado == 'cancelado'">
                            <field name="name"/>
                            <field name="fecha"/>
                            <field name="cantidad_total"/>
                            <field name="currency_id" column_invisible="True"/>
                            <field name="total" widget="monetary" sum="Total"/>
                            <field name="estado" widget="badge"
                                   decoration-info="estado == 'confirmado'"
                                   decoration-success="estado in ('pagado', 'entregado')"
                                   decoration-danger="estado == 'cancelado'"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- ================================================================ -->
    <!-- LISTA específica de clientes                                      -->
    <!-- ================================================================ -->
    <record id="view_res_partner_list_gamestore" model="ir.ui.view">
        <field name="name">res.partner.list.gamestore</field>
        <field name="model">res.partner</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list string="Clientes">
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="city" optional="show"/>
                <field name="gamestore_plataforma_favorita_id" optional="show"/>
                <field name="gamestore_pedido_count"/>
                <field name="gamestore_currency_id" column_invisible="True"/>
                <field name="gamestore_total_gastado" widget="monetary"/>
                <field name="gamestore_ultima_compra" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_res_partner_search_gamestore" model="ir.ui.view">
        <field name="name">res.partner.search.gamestore</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='inactive']" position="before">
                <filter name="clientes_gamestore" string="Clientes GameStore"
                        domain="[('es_cliente_gamestore', '=', True)]"/>
                <separator/>
            </xpath>
        </field>
    </record>

    <record id="action_gamestore_clientes" model="ir.actions.act_window">
        <field name="name">Clientes</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('es_cliente_gamestore', '=', True)]</field>
        <field name="context">{'default_es_cliente_gamestore': True, 'default_is_company': False}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_res_partner_list_gamestore')}),
            (0, 0, {'view_mode': 'kanban'}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('base.view_partner_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Registra tu primer cliente</p>
            <p>Los contactos que realicen un pedido se marcan automáticamente como clientes.</p>
        </field>
    </record>
</odoo>
