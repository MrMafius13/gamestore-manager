<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- PLATAFORMAS -->
    <record id="view_gamestore_plataforma_list" model="ir.ui.view">
        <field name="name">gamestore.plataforma.list</field>
        <field name="model">gamestore.plataforma</field>
        <field name="arch" type="xml">
            <list string="Plataformas" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="fabricante"/>
                <field name="color" widget="color_picker"/>
                <field name="videojuego_count"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="action_gamestore_plataforma" model="ir.actions.act_window">
        <field name="name">Plataformas</field>
        <field name="res_model">gamestore.plataforma</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crea tu primera plataforma</p>
            <p>PlayStation 5, Xbox Series X|S, Nintendo Switch, PC...</p>
        </field>
    </record>

    <!-- GÉNEROS -->
    <record id="view_gamestore_genero_list" model="ir.ui.view">
        <field name="name">gamestore.genero.list</field>
        <field name="model">gamestore.genero</field>
        <field name="arch" type="xml">
            <list string="Géneros" editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="action_gamestore_genero" model="ir.actions.act_window">
        <field name="name">Géneros</field>
        <field name="res_model">gamestore.genero</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crea tu primer género</p>
            <p>Acción, Aventura, RPG, Deportes...</p>
        </field>
    </record>

    <!-- DESARROLLADORAS -->
    <record id="view_gamestore_desarrolladora_list" model="ir.ui.view">
        <field name="name">gamestore.desarrolladora.list</field>
        <field name="model">gamestore.desarrolladora</field>
        <field name="arch" type="xml">
            <list string="Desarrolladoras">
                <field name="name"/>
                <field name="pais_id"/>
                <field name="sitio_web" widget="url"/>
                <field name="videojuego_count"/>
            </list>
        </field>
    </record>

    <record id="view_gamestore_desarrolladora_form" model="ir.ui.view">
        <field name="name">gamestore.desarrolladora.form</field>
        <field name="model">gamestore.desarrolladora</field>
        <field name="arch" type="xml">
            <form string="Desarrolladora">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_ver_videojuegos" type="object" class="oe_stat_button" icon="fa-gamepad">
                            <field name="videojuego_count" widget="statinfo" string="Videojuegos"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archivada" bg_color="text-bg-secondary" invisible="active"/>
                    <field name="logo" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="p. ej. Nintendo EPD"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="pais_id"/>
                            <field name="sitio_web" widget="url"/>
                        </group>
                        <group>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_gamestore_desarrolladora" model="ir.actions.act_window">
        <field name="name">Desarrolladoras</field>
        <field name="res_model">gamestore.desarrolladora</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Registra tu primera desarrolladora</p>
        </field>
    </record>
</odoo>
