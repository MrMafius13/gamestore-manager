{
  "name": "GameStore Manager (Odoo 18)",
  "forwardPorts": [8069],
  "portsAttributes": {
    "8069": {
      "label": "GameStore ERP (Odoo 18)",
      "onAutoForward": "openBrowser",
      "visibility": "public"
    }
  },
  "postCreateCommand": "docker compose up -d && python3 scripts/wait_for_odoo.py",
  "postStartCommand": "docker compose up -d",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "redhat.vscode-xml"
      ],
      "settings": {
        "python.analysis.typeCheckingMode": "off",
        "files.exclude": {
          "**/__pycache__": true
        }
      }
    }
  }
}
